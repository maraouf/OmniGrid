#!/usr/bin/env bash
# OmniGrid pre-commit shim — the full gate: lint, project-wide audits, tests.
#
# Checked in at .githooks/pre-commit and activated per-clone by
# `python scripts/install_precommit.py` (which sets core.hooksPath to
# .githooks). Edit here + commit to update the hook on every machine; re-run
# the installer once per fresh clone to activate. Skip for ONE commit with
# `git commit --no-verify`.
#
# Three stages, ALL of which must pass. Nothing is advisory: any WARNING or
# ERROR blocks the commit (info-level prints but does not block).
#
#   1. Lint the STAGED files with every per-file rule.
#   2. Run the project-wide audits. These are a SEPARATE pass because
#      run_lint() filters them out unless mode == "all" — a --staged run does
#      not include them, and a partial-staged commit can still introduce
#      project-wide drift. The rule ids are read back from `--list` so a newly
#      added audit is picked up here without editing this hook.
#   3. Run the test suite.
#
# Stage 1 is fast (staged files only). Stage 2 is ~8s. Stage 3 is ~7s. A full
# per-file lint of the whole tree takes minutes and is deliberately NOT here —
# run `python scripts/lint.py --all` by hand for that.
set -eu

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$repo_root" ]; then
  echo "[pre-commit] not in a git repo — skipping" >&2
  exit 0
fi

lint="$repo_root/scripts/lint.py"
if [ ! -f "$lint" ]; then
  # Hook active but the lint script is gone — don't block commits silently.
  echo "[pre-commit] $lint not found — skipping" >&2
  exit 0
fi

# Resolve a python interpreter — prefer `python` (Windows) then python3.
if command -v python >/dev/null 2>&1; then
  py="python"
elif command -v python3 >/dev/null 2>&1; then
  py="python3"
else
  echo "[pre-commit] neither python nor python3 on PATH — skipping" >&2
  exit 0
fi

rc=0

# ---------------------------------------------------------------------------
# 1. Staged-file lint
# ---------------------------------------------------------------------------
# Capture the staged text-file set BEFORE normalising so we can re-stage the
# CRLF-fixed bytes below. NUL-delimited for path-with-space safety.
# diff-filter ACMR = Added / Copied / Modified / Renamed (skip Deletes).
staged="$(git diff --cached --name-only --diff-filter=ACMR -z 2>/dev/null || true)"

# --fix-crlf auto-normalises staged files to CRLF FIRST (the harness's
# Edit/Write tools silently re-save edited files as LF on every edit, so
# without this the commit would fail the lone-LF rule on every touched file).
# --severity warn then blocks on any remaining WARNING or ERROR.
set +e
"$py" "$lint" --staged --fix-crlf --severity warn
[ $? -ne 0 ] && rc=1
set -e

# Re-stage the normalised bytes so the CRLF fix lands in THIS commit instead of
# being left as an unstaged change that re-fails the next commit. Caveat: a
# partially-staged file (git add -p) gets its FULL working-tree version
# re-staged here — acceptable for this single-operator repo; use --no-verify if
# a partial stage must survive verbatim.
if [ -n "$staged" ]; then
  printf '%s' "$staged" | xargs -0 git add -- 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 2. Project-wide audits
# ---------------------------------------------------------------------------
# `--audits` selects the audit set inside lint.py, so this hook never drifts
# from the registry — adding scripts/audit_<new>.py + its RULES entry is enough.
# (An earlier version scraped the ids out of `--list`; the two descriptions
# containing an em dash / ellipsis came back re-encoded when stdout is not a
# TTY and the scrape carried description text into the rule id.)
set +e
"$py" "$lint" --audits --severity warn
[ $? -ne 0 ] && rc=1
set -e

# ---------------------------------------------------------------------------
# 3. Tests
# ---------------------------------------------------------------------------
# Graceful no-op when pytest isn't installed, matching the contract py-typecheck
# uses for a missing pyright: a contributor without the dev deps is informed,
# not blocked. `pip install -r requirements-dev.txt` enables it.
if [ -d "$repo_root/tests" ]; then
  if "$py" -c "import pytest" >/dev/null 2>&1; then
    set +e
    "$py" -m pytest "$repo_root/tests" -q
    [ $? -ne 0 ] && rc=1
    set -e
  else
    echo "[pre-commit] pytest not installed — tests SKIPPED" >&2
    echo "[pre-commit]   pip install -r requirements-dev.txt   # to enable" >&2
  fi
fi

if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "[pre-commit] commit BLOCKED — fix the findings above." >&2
  echo "[pre-commit] Deliberate bypass for one commit: git commit --no-verify" >&2
fi

exit "$rc"
